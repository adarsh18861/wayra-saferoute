{
  "name": "wayra-saferoute",
  "private": true,
  "version": "0.0.0",
  "description": "WAYRA \u00e2\u20ac\u201c SafeRoute: safest-route navigation web app (Chicago pilot)",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev": "concurrently -k -n backend,frontend -c magenta,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "data": "npm run data:download && npm run data:clean",
    "data:download": "backend\\.venv\\Scripts\\python.exe ml/01_download.py",
    "data:clean": "backend\\.venv\\Scripts\\python.exe ml/02_clean.py",
    "ml:data": "npm run data",
    "features": "backend\\.venv\\Scripts\\python.exe ml/03_features.py",
    "train": "npm run features && backend\\.venv\\Scripts\\python.exe ml/04_train.py",
    "score": "backend\\.venv\\Scripts\\python.exe ml/05_score_edges.py",
    "ml:train": "npm run train",
    "ml:score": "npm run score",
    "test": "npm run test:backend && npm run test:ml && npm run test:frontend",
    "test:backend": "cd backend && .venv\\Scripts\\python.exe -m pytest -q",
    "test:ml": "cd ml && ..\\backend\\.venv\\Scripts\\python.exe -m pytest -q",
    "test:frontend": "npm --prefix frontend run typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}

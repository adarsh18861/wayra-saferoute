# Copy to .env and fill in. Never commit .env.

# Backend
DATABASE_URL=sqlite:///./wayra.db
# JWT signing key: replace with a long random string (32+ chars), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]

# Place search (OpenStreetMap Nominatim). Its usage policy asks for an identifying User-Agent;
# add a contact URL or email here before deploying publicly.
NOMINATIM_USER_AGENT=WAYRA-SafeRoute/0.1 (women-safety routing prototype)

# Optional notifiers (simulated in-app notifier is used when these are empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

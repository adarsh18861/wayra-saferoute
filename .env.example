# Copy to .env and fill in. Never commit .env.

# Backend
DATABASE_URL=sqlite:///./wayra.db
JWT_SECRET=change-me
CORS_ORIGINS=["http://localhost:5173"]

# Optional notifiers (simulated in-app notifier is used when these are empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
